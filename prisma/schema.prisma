datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model account {
  id      Int      @id @default(autoincrement())
  firstName String?
  lastName  String?
  email String   @unique
  logements logement[]
}

model propertyType {
  id   Int    @id @default(autoincrement())
  type String @unique
  logements   logement[]
}

model logementType {
  id   Int    @id @default(autoincrement())
  type String @unique
  logements   logement[]
}

model logement {
  id                   Int          @id @default(autoincrement())
  accountId            Int
  logementTypeId       Int
  propertyTypeId       Int?
  showAddress Boolean
  streetNumber String
  streetName String
  city String
  postalCode    Int
  addressComplement String?

  superficie           Int
  roomNumber           Int
  bedroomNumber        Int
  roomAreas            roomArea[]
  furnished            Boolean
  bathRoomSpace        Int
  powderRoomSpace      Int
  floorNumber      Int?
  spaceShares          spaceShare[]
  kWhEP                Int
  kgCO2                Int
  draft                Boolean @default(false)
  stopProcess          String?
  account              account?     @relation(fields: [accountId], references: [id])
  propertyType         propertyType? @relation(fields: [propertyTypeId], references: [id])
  logementType         logementType? @relation(fields: [logementTypeId], references: [id])
}

model roomArea {
  id        Int       @id @default(autoincrement())
  area      Int?
  logement  logement? @relation(fields: [logementId], references: [id])
  logementId Int?
}

model spaceShare {
  id        Int       @id @default(autoincrement())
  type      String?
  logement  logement? @relation(fields: [logementId], references: [id])
  logementId Int?
}

